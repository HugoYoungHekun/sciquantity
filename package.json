{
  "name": "sciquantity",
  "version": "0.1.0",
  "description": "A flexible, multi-language physical quantity library for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "user": "^0.0.0"
  }
}
